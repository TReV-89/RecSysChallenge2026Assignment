# Create a key in https://console.groq.com/keys. Free-plan quotas apply.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional for GPT-OSS: low reduces reasoning token usage during evaluation.
GROQ_REASONING_EFFORT=
# json_schema for models supporting Groq strict structured output;
# function_calling is available for models with tool calling only.
GROQ_OUTPUT_METHOD=json_schema
# Recommendation provider. OpenRouter credentials below are used both by the
# evaluation judge and, whenever set, as a dedicated second provider for the
# live agent's explanation step - separate from the main loop's rate budget.
# Leave OPEN_ROUTER_API_KEY blank to have explanations reuse the main LLM.
LLM_PROVIDER=groq
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_OUTPUT_METHOD=function_calling
# OPENROUTER_API_KEY / OPENROUTER_MODEL are also accepted.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
TRACK_EMBEDDING_COLUMN=metadata-qwen3_embedding_0.6b
# Optional catalog index: "catalog" (default) or "sample".
TALKPLAY_CATALOG=catalog
# Use internal_validation only with the matching cf_data import and held-out evaluation.
CF_HISTORY_MODE=official_test
# Optional Hugging Face authentication for downloads.
HF_TOKEN=
