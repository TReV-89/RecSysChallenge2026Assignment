# Create a key in https://console.groq.com/keys. Free-plan quotas apply.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# json_schema for models supporting Groq strict structured output;
# function_calling is available for models with tool calling only.
GROQ_OUTPUT_METHOD=json_schema
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
TRACK_EMBEDDING_COLUMN=metadata-qwen3_embedding_0.6b
# Optional Hugging Face authentication for downloads.
HF_TOKEN=
